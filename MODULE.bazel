module(
    name = "robo_viewer",
    version = "1.0.0",
)

# --- Core Dependencies ---
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# --- Graphics & Math Stack (Native BCR) ---
bazel_dep(name = "glfw", version = "3.4.0")
bazel_dep(name = "glm", version = "1.0.1")
bazel_dep(name = "glew", version = "2.2.0")
bazel_dep(name = "nlohmann_json", version = "3.11.3")
bazel_dep(name = "imgui", version = "1.92.2")
bazel_dep(name = "tinyxml2", version = "10.0.0")

# --- External Physics Engine (Jolt) ---
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# --- LSP Integration (compile_commands.json generator) ---
http_archive(
    name = "hedron_compile_commands",
    url = "https://github.com/hedronvision/bazel-compile-commands-extractor/archive/0e990032f3c5a866e72615cf67e5ce22186dcb97.tar.gz",
    strip_prefix = "bazel-compile-commands-extractor-0e990032f3c5a866e72615cf67e5ce22186dcb97",
)

http_archive(
    name = "jolt",
    build_file = "@//third_party:jolt.BUILD",
    strip_prefix = "JoltPhysics-5.0.0",
    url = "https://github.com/jrouwe/JoltPhysics/archive/refs/tags/v5.0.0.tar.gz",
    patches = ["@//patches:jolt_job_system_threads.patch"],
    patch_args = ["-p1"],
)

# --- Morphologica for visualization ---
http_archive(
    name = "morphologica",
    build_file = "@//third_party:morphologica.BUILD",
    strip_prefix = "morphologica-4.1",
    url = "https://github.com/ABRG-Models/morphologica/archive/refs/tags/v4.1.tar.gz",
)

# Assimp (headers) with system linkopts
http_archive(
    name = "assimp",
    url = "https://github.com/assimp/assimp/archive/refs/tags/v5.3.1.tar.gz",
    strip_prefix = "assimp-5.3.1",
    build_file = "@//third_party:assimp.BUILD",
)

# --- Sokol - Single-header graphics (headers downloaded) ---
# Headers in third_party/sokol/ - needs upstream fix for compilation

# --- bgfx - Cross-platform rendering (NOT ENABLED) ---
# bgfx requires additional dependencies (bx, bimg) and ~50MB of source
# To enable: download bgfx to third_party/bgfx/ and update bgfx.BUILD
